{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "isolatedModules": false,
    "types": ["node"],
    "paths": {
      "@yumeshelf/engine": ["./packages/yume-engine/dist/index.d.ts"],
      "@yumeshelf/engine/types": ["./packages/yume-engine/dist/types.d.ts"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/shared/**/*",
    "src/main.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ],
  "references": [
    {
      "path": "./packages/yume-engine"
    }
  ]
}
