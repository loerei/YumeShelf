{
  "name": "yumeshelf",
  "version": "1.5.12",
  "author": "loerei",
  "description": "YumeShelf Game Library Launcher",
  "main": "dist/main.js",
  "scripts": {
    "ensure:playtime-helper": "node .\\scripts\\ensure-playtime-helper.js",
    "ensure:installer-shell": "node .\\scripts\\ensure-installer-shell.js",
    "ensure:installer-shell:fast": "node .\\scripts\\ensure-installer-shell.js --fast",
    "organize:build-output": "node .\\scripts\\organize-build-output.js",
    "copy:assets": "copyfiles -u 1 \"src/main/save-editor/bin/**/*\" \"src/locales/builtins/**/*\" \"src/icon-extractor.js\" dist",
    "build:main": "tsc -p tsconfig.main.json",
    "start:main": "npm run copy:assets && tsc -p tsconfig.main.json --watch",
    "start:electron": "nodemon --watch src/main --watch src/shared --watch src/main.ts --watch src/preload.ts --ext ts,js --delay 2 --exec \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron dist/main.js\"",
    "start": "node -e \"if(process.platform==='win32')require('child_process').execSync('chcp 65001')\" && npm run ensure:playtime-helper && npm run build:preload && npm run build:main && concurrently -k \"npm run start:main\" \"vite\" \"npm run start:electron\"",
    "build:vite": "vite build",
    "build": "npm run ensure:playtime-helper && npm run build:preload && npm run build:main && npm run ensure:installer-shell && npm run copy:assets && npm run build:vite && electron-builder --win && npm run organize:build-output",
    "build:fast": "npm run ensure:playtime-helper && npm run build:preload && npm run build:main && npm run ensure:installer-shell:fast && npm run copy:assets && npm run build:vite && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win --config.win.signtoolOptions.sign=./scripts/noop-windows-sign.js && npm run organize:build-output",
    "build:fast:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\clean-win-unpacked.ps1 && npm run build:fast",
    "build:test-version": "node .\\scripts\\build-test-version.js",
    "build:dir": "npm run ensure:playtime-helper && npm run build:preload && npm run build:main && npm run copy:assets && npm run build:vite && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win --dir && npm run organize:build-output",
    "build:dir:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\clean-win-unpacked.ps1 && npm run build:dir",
    "checksum:release": "node .\\scripts\\write-release-checksum.js",
    "mock:app-update": "node .\\scripts\\write-dev-app-update-manifest.js",
    "mock:app-update:serve": "node .\\scripts\\serve-dev-app-update-feed.js",
    "sync:release-metadata": "node .\\scripts\\sync-release-metadata.js",
    "release": "node .\\scripts\\release.js",
    "compile:release-notes": "node .\\scripts\\compile-release-notes.js",
    "compile:release-notes:release": "node .\\scripts\\compile-release-notes.js --release",
    "typecheck": "tsc --noEmit",
    "build:preload": "tsup src/preload.ts --out-dir dist --format cjs --external electron",
    "build:ts": "tsup src/main.js --out-dir dist --format cjs"
  },
  "build": {
    "appId": "com.loerei.yumeshelf",
    "productName": "YumeShelf",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/extract-file-icon/**/*",
      "dist/main/save-editor/bin/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "loerei",
        "repo": "YumeShelf"
      }
    ],
    "electronUpdaterCompatibility": ">=2.16",
    "files": [
      "dist/**/*",
      "package.json",
      "locales/**/*",
      "assets/**/*",
      "!src/**/*",
      "!YumeShelf/**/*",
      "!build_output/**/*"
    ],
    "directories": {
      "output": "build_output"
    },
    "extraResources": [
      {
        "from": "native/playtime-helper/target/release/playtime-helper.exe",
        "to": "native/playtime-helper/playtime-helper.exe"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/yumeshelf_icon_highres_4096.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/electron": "^1.4.38",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "builder-util-runtime": "^9.7.0",
    "concurrently": "^9.2.1",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "electron": "^29.0.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "nodemon": "^3.1.14",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "web-tree-sitter": "^0.20.8"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.3",
    "extract-file-icon": "^0.3.2",
    "js-yaml": "^5.2.1"
  }
}
