{
  "name": "h-game-launcher",
  "version": "1.0.6",
  "description": "Smart Game Library Launcher",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.sayus.launcher",
    "productName": "H-Game Launcher",
    "directories": {
      "output": "build_output"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^26.8.1"
  },
  "productName": "YumeShelf"
}
