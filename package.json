{
  "name": "yumeshelf",
  "version": "1.5.1",
  "author": "loerei",
  "description": "YumeShelf Game Library Launcher",
  "main": "src/main.js",
  "scripts": {
    "ensure:playtime-helper": "node .\\scripts\\ensure-playtime-helper.js",
    "ensure:installer-shell": "node .\\scripts\\ensure-installer-shell.js",
    "ensure:installer-shell:fast": "node .\\scripts\\ensure-installer-shell.js --fast",
    "organize:build-output": "node .\\scripts\\organize-build-output.js",
    "start": "node -e \"if(process.platform==='win32')require('child_process').execSync('chcp 65001')\" && npm run ensure:playtime-helper && electron .",
    "build": "npm run ensure:playtime-helper && npm run ensure:installer-shell && electron-builder --win && npm run organize:build-output",
    "build:fast": "npm run ensure:playtime-helper && npm run ensure:installer-shell:fast && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win --config.win.signtoolOptions.sign=./scripts/noop-windows-sign.js && npm run organize:build-output",
    "build:fast:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\clean-win-unpacked.ps1 && npm run build:fast",
    "build:test-version": "node .\\scripts\\build-test-version.js",
    "build:dir": "npm run ensure:playtime-helper && set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder --win --dir && npm run organize:build-output",
    "build:dir:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\clean-win-unpacked.ps1 && npm run build:dir",
    "checksum:release": "node .\\scripts\\write-release-checksum.js",
    "mock:app-update": "node .\\scripts\\write-dev-app-update-manifest.js",
    "mock:app-update:serve": "node .\\scripts\\serve-dev-app-update-feed.js",
    "sync:release-metadata": "node .\\scripts\\sync-release-metadata.js"
  },
  "build": {
    "appId": "com.loerei.yumeshelf",
    "productName": "YumeShelf",
    "publish": [
      {
        "provider": "github",
        "owner": "loerei",
        "repo": "YumeShelf"
      }
    ],
    "electronUpdaterCompatibility": ">=2.16",
    "files": [
      "src/**/*",
      "package.json",
      "!YumeShelf/**/*",
      "!build_output/**/*"
    ],
    "directories": {
      "output": "build_output"
    },
    "extraResources": [
      {
        "from": "native/playtime-helper/target/release/playtime-helper.exe",
        "to": "native/playtime-helper/playtime-helper.exe"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/yumeshelf_icon_highres_4096.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "extract-file-icon": "^0.3.2"
  }
}
